{
    "name": "react-native-page-flipper",
    "version": "1.0.1",
    "description": "Page Flipper",
    "main": "lib/commonjs/index",
    "module": "lib/module/index",
    "react-native": "src/index",
    "types": "lib/typescript/index.d.ts",
    "source": "src/index",
    "files": [
        "src",
        "lib",
        "android",
        "ios"
    ],
    "scripts": {
        "build": "bob build",
        "typescript": "tsc --noEmit",
        "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
        "dev": "pnpm watch 'pnpm build' ./src",
        "prepare": "node ./scripts/prepare.js",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "react-native",
        "ios",
        "android",
        "page",
        "flip",
        "page-flip",
        "flipper",
        "page-flipper"
    ],
    "repository": "https://github.com/chris24elias/react-native-page-flipper",
    "author": "Chris (https://github.com/chris24elias)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/chris24elias/react-native-page-flipper/issues"
    },
    "homepage": "https://github.com/chris24elias/react-native-page-flipper#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "devDependencies": {
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@react-native-community/eslint-config": "^2.0.0",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.2.2",
        "babel-plugin-module-resolver": "^4.1.0",
        "eslint": "^7.2.0",
        "eslint-config-prettier": "^7.0.0",
        "eslint-plugin-prettier": "^3.1.3",
        "expo-linear-gradient": "^56.0.4",
        "husky": "^4.2.5",
        "jest": "^29.7.0",
        "metro-react-native-babel-preset": "^0.77.0",
        "prettier": "^2.0.5",
        "react": "19.2.3",
        "react-native": "0.85.3",
        "react-native-builder-bob": "^0.18.1",
        "react-native-gesture-handler": "^2.31.2",
        "react-native-linear-gradient": "^2.6.2",
        "react-native-reanimated": "4.3.1",
        "react-native-worklets": "0.8.3",
        "typescript": "~6.0.3"
    },
    "peerDependencies": {
        "expo-linear-gradient": "*",
        "react": ">=16.8.0",
        "react-native": ">=0.6.0",
        "react-native-gesture-handler": "*",
        "react-native-linear-gradient": "^2.5.6",
        "react-native-reanimated": ">=3.0.0 || ^4.0.0",
        "react-native-worklets": ">=0.5.0"
    },
    "peerDependenciesMeta": {
        "expo-linear-gradient": {
            "optional": true
        },
        "react-native-worklets": {
            "optional": true
        }
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            [
                "commonjs",
                {
                    "configFile": "./babel.config.build.js"
                }
            ],
            [
                "module",
                {
                    "configFile": "./babel.config.build.js"
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    },
    "packageManager": "pnpm@11.1.3",
    "pnpm": {
        "overrides": {
            "@types/react": "~19.2.2"
        }
    }
}
